<div class="layout layout--col gap--small p--4 lg:p--5" data-game-view="quadrant">
{% render "section_heading" with heading: "Hall of Fame", year: year %}
<div class="flex flex--col gap--distribute w--full grow h--0 h--min-0">
{% for game in hall limit: 10 %}
{% assign slot = '' %}{% assign divider = '' %}
{% if forloop.index > 8 %}{% assign slot = 'hidden lg:portrait:flex' %}{% elsif forloop.index > 5 %}{% assign slot = 'hidden lg:flex' %}{% endif %}
{% if forloop.last %}{% assign slot = slot | append: ' lg:grow-0 lg:h--10' %}{% assign divider = 'hidden' %}
{% elsif forloop.index == 5 %}{% assign slot = slot | append: ' lg:grow lg:h--auto' %}{% assign divider = 'hidden lg:block' %}
{% elsif forloop.index == 8 %}{% assign slot = slot | append: ' lg:grow-0 lg:h--10 lg:portrait:grow lg:portrait:h--auto' %}{% assign divider = 'lg:hidden lg:portrait:block' %}{% endif %}
{% render "ranking_row" with game: game, rank: forloop.index, row_class: "py--1", score_class: "value--xxsmall lg:value--xsmall lg:portrait:value--xxsmall", title_class: "lg:title--base lg:portrait:title--small", title_lines: 1, slot_class: slot, divider_class: divider %}
{% else %}{% render "empty_state" %}{% endfor %}
</div>
</div>
{% render "plugin_footer" with platform: platform_label, is_stale: stale %}

