<div class="layout layout--col gap--small p--4 lg:p--5" data-game-view="full">
<div class="grid grid--cols-2 gap--medium lg:gap--large w--full h--full">
<div class="flex flex--col gap--small w--full h--full h--min-0">
{% render "section_heading" with heading: "Hall of Fame", year: year %}
<div class="flex flex--col gap--distribute w--full grow h--0 h--min-0">
{% for game in hall limit: 12 %}
{% assign slot = '' %}{% assign divider = '' %}
{% if forloop.index > 10 %}{% assign slot = 'hidden lg:portrait:flex' %}{% elsif forloop.index > 8 %}{% assign slot = 'hidden lg:flex' %}{% endif %}
{% if forloop.last %}{% assign slot = slot | append: ' lg:grow-0 lg:h--12 lg:portrait:h--16' %}{% assign divider = 'hidden' %}
{% elsif forloop.index == 8 %}{% assign slot = slot | append: ' lg:grow lg:h--auto' %}{% assign divider = 'hidden lg:block' %}
{% elsif forloop.index == 10 %}{% assign slot = slot | append: ' lg:grow-0 lg:h--12 lg:portrait:grow lg:portrait:h--auto' %}{% assign divider = 'lg:hidden lg:portrait:block' %}{% endif %}
{% assign featured = forloop.first %}{% assign score_class = "value--xxsmall lg:value--xsmall" %}{% if featured %}{% assign score_class = "value--small" %}{% endif %}
{% render "ranking_row" with game: game, rank: forloop.index, featured: featured, score_class: score_class, title_class: "lg:title--base", title_lines: 2, slot_class: slot, divider_class: divider, image_class: "w--28 lg:w--36 lg:portrait:w--24" %}
{% else %}{% render "empty_state" %}{% endfor %}
</div></div>
<div class="flex flex--col gap--medium lg:gap--large border--v-50 pl--4 lg:pl--5 w--full h--full h--min-0">
<div class="flex flex--col gap--small w--full grow h--0 h--min-0">
{% render "section_heading" with heading: "Just released" %}
<div class="flex flex--col gap--distribute w--full grow h--0 h--min-0">
{% for game in recent limit: 6 %}
{% assign slot = '' %}{% assign divider = '' %}
{% if forloop.index > 5 %}{% assign slot = 'hidden lg:flex' %}{% endif %}
{% if forloop.last %}{% assign slot = slot | append: ' lg:grow-0 lg:h--12 lg:portrait:h--16' %}{% assign divider = 'hidden' %}
{% elsif forloop.index == 5 %}{% assign slot = 'lg:grow lg:h--auto' %}{% assign divider = 'hidden lg:block' %}{% endif %}
{% render "release_row" with game: game, slot_class: slot, divider_class: divider %}
{% else %}{% render "empty_state" %}{% endfor %}
</div></div><div class="flex flex--col gap--small w--full grow h--0 h--min-0">
{% render "section_heading" with heading: "Coming next" %}
<div class="flex flex--col gap--distribute w--full grow h--0 h--min-0">
{% for game in upcoming limit: 6 %}
{% assign slot = '' %}{% assign divider = '' %}
{% if forloop.index > 5 %}{% assign slot = 'hidden lg:flex' %}{% endif %}
{% if forloop.last %}{% assign slot = slot | append: ' lg:grow-0 lg:h--12 lg:portrait:h--16' %}{% assign divider = 'hidden' %}
{% elsif forloop.index == 5 %}{% assign slot = 'lg:grow lg:h--auto' %}{% assign divider = 'hidden lg:block' %}{% endif %}
{% render "release_row" with game: game, slot_class: slot, divider_class: divider %}
{% else %}{% render "empty_state" %}{% endfor %}
</div></div>
</div></div>
</div>
{% render "plugin_footer" with platform: platform_label, is_stale: stale %}

